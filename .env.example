DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fashion_dev_local
DB_USER=root
DB_PASSWORD=
APP_ENV=development
# Required by the bearer-token authentication API. Generate a private random value of 32+ bytes.
AUTH_TOKEN_SECRET=
# Aiven CA certificate path (optional; enables certificate and hostname verification).
DB_SSL_CA=
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Public backend URL used by the static frontend config.js; never put DB credentials here.
FRONTEND_API_URL=http://127.0.0.1:8000
